{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyfactor.github.io/v2/integration-manifest-schema.json",
  "title": "Keyfactor Integration Manifest Schema v2",
  "description": "The JSON Schema used by Keyfactor Integrations to store integration-related metadata",
  "examples": [
    {
      "name": "Sample Integration",
      "description": "A sample integration manifest for demonstration",
      "integration_type": "orchestrator",
      "support_level": "community",
      "status": "prototype",
      "link_github": false,
      "update_catalog": false
    },
    {
      "name": "DNS Plugin",
      "description": "Example DNS plugin",
      "integration_type": "dns-plugin",
      "support_level": "kf-community",
      "status": "pilot",
      "link_github": false,
      "update_catalog": false,
      "release_dir": "Keyfactor.DnsProvider.ExampleDNS/bin/Release",
      "release_project": "Keyfactor.DnsProvider.ExampleDNS/Keyfactor.DnsProvider.ExampleDNS.csproj",
      "about": {
        "dns_provider": {
          "providerName": "exampledns",
          "displayName": "Example DNS",
          "assemblyName": "ExampleDNSDomainValidator",
          "fullyQualifiedClassName": "Keyfactor.Extensions.DomainValidator.ExampleDNS.ExampleDNSDomainValidator",
          "validationType": "dns-01",
          "dns_provider_config": [
            {
              "Name": "ExampleDNS_AccessKey",
              "DisplayName": "Example DNS Access Key ID",
              "DataType": 1,
              "InstanceLevel": false,
              "Hidden": false,
              "DefaultValue": "",
              "Required": false,
              "Description": "Example DNS: Access Key ID. Optional if using default credential chain."
            },
            {
              "Name": "ExampleDNS_SecretKey",
              "DisplayName": "Example DNS Secret Access Key",
              "DataType": 2,
              "InstanceLevel": false,
              "Hidden": true,
              "DefaultValue": "",
              "Required": false,
              "Description": "Example DNS: Secret Access Key. Optional if using default credential chain."
            }
          ]
        }
      }
    }
  ],
  "$ref": "#/$defs/IntegrationManifest",
  "$defs": {
    "AboutDnsProvider": {
      "type": "object",
      "required": [
        "providerName",
        "displayName",
        "assemblyName",
        "fullyQualifiedClassName",
        "validationType",
        "dns_provider_config"
      ],
      "properties": {
        "providerName": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "fullyQualifiedClassName": {
          "type": "string"
        },
        "validationType": {
          "type": "string"
        },
        "dns_provider_config": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Name",
              "DisplayName",
              "DataType",
              "InstanceLevel",
              "Hidden",
              "DefaultValue",
              "Required",
              "Description"
            ],
            "properties": {
              "Name": {
                "type": "string"
              },
              "DisplayName": {
                "type": "string"
              },
              "DataType": {
                "type": "integer"
              },
              "InstanceLevel": {
                "type": "boolean"
              },
              "Hidden": {
                "type": "boolean"
              },
              "DefaultValue": {
                "type": "string"
              },
              "Required": {
                "type": "boolean"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "IntegrationManifest": {
      "type": "object",
      "required": [
        "name",
        "description",
        "integration_type",
        "support_level",
        "status",
        "link_github",
        "update_catalog"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "integration_type": { "const": "orchestrator" } }
          },
          "then": {
            "properties": {
              "about": {
                "type": "object",
                "required": ["orchestrator"],
                "properties": {
                  "orchestrator": { "$ref": "#/$defs/AboutOrchestrator" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "integration_type": { "const": "pam" } }
          },
          "then": {
            "properties": {
              "about": {
                "type": "object",
                "required": ["pam"],
                "properties": {
                  "pam": { "$ref": "#/$defs/AboutPam" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "integration_type": { "const": "anyca-plugin" } }
          },
          "then": {
            "properties": {
              "about": {
                "type": "object",
                "required": ["carest"],
                "properties": {
                  "carest": { "$ref": "#/$defs/AboutAnyCAREST" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "integration_type": { "const": "dns-plugin" } }
          },
          "then": {
            "properties": {
              "about": {
                "type": "object",
                "required": ["dns_provider"],
                "properties": {
                  "dns_provider": { "$ref": "#/$defs/AboutDnsProvider" }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "description": "The name of the integration, excluding the type",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "A high level description of the integration",
          "type": "string",
          "minLength": 1
        },
        "integration_type": {
          "description": "Type of integration.  This should be one of the following: orchestrator, windows-orchestrator, iot-orchestrator, orchestrator-registration, registration-handler, ca-gateway, approval-handler, metadata, alert-handler, api-client, pam, terraform, or dns-plugin",
          "enum": [
            "orchestrator",
            "windows-orchestrator",
            "orchestrator-registration",
            "iot-orchestrator",
            "registration-handler",
            "ca-gateway",
            "anyca-plugin",
            "approval-handler",
            "metadata",
            "alert-handler",
            "api-client",
            "pam",
            "terraform",
            "ejbca",
            "signserver",
            "dns-plugin"
          ]
        },
        "support_level": {
          "description": "Level of support effort",
          "enum": ["community", "kf-community", "kf-supported"]
        },
        "status": {
          "description": "Status of the integration.  This should be one of the following: prototype, pilot, production",
          "enum": ["prototype", "pilot", "production"]
        },
        "link_github": {
          "description": "Generate link to GitHub repository when generating the Integration Catalog",
          "type": "boolean"
        },
        "update_catalog": {
          "description": "Generate an entry in the Integration Catalog",
          "type": "boolean"
        },
        "winSupport": {
          "description": "Description of Windows platform-specific notes",
          "type": "string"
        },
        "release_dir": {
          "description": "location of folder or filename(s) for built binaries",
          "type": "string"
        },
        "pamRegDLL": {
          "description": "location of folder or filename(s) for PAM configuration/installation/registration",
          "type": "string"
        },
        "about": {
          "description": "Various capability information for an integration type",
          "type": "object",
          "maxProperties": 1,
          "properties": {
            "orchestrator": {
              "$ref": "#/$defs/AboutOrchestrator"
            },
            "pam": {
              "$ref": "#/$defs/AboutPam"
            },
            "carest": {
              "$ref": "#/$defs/AboutAnyCAREST"
            },
            "dns_provider": {
              "$ref": "#/$defs/AboutDnsProvider"
            }
          }
        }
      }
    },
    "AboutOrchestrator": {
      "type": "object",
      "properties": {
        "UOFramework": {
          "description": "If present, this will be displayed in the readme as the minimum version of the Universal Orchestrator Framework required to run the integration",
          "type": "string"
        },
        "keyfactor_platform_version": {
          "description": "Keyfactor Command Platform minimum version",
          "type": "string"
        },
        "store_types": {
          "description": "List of store types supported by the integration",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoreType"
          }
        }
      }
    },
    "AboutPam": {
      "type": "object",
      "required": [
        "assemblyName",
        "providerName",
        "fullyQualifiedClassName",
        "dbName"
      ],
      "properties": {
        "assemblyName": {
          "type": "string",
          "description": "The name of the PAM provider assembly, excluding the file extension",
          "minLength": 1
        },
        "providerName": {
          "type": "string",
          "description": "The name of the PAM provider",
          "minLength": 1
        },
        "fullyQualifiedClassName": {
          "type": "string",
          "description": "The fully qualified class name of the PAM provider implementation, including namespace",
          "minLength": 1
        },
        "dbName": {
          "type": "string",
          "description": "The name of the PAM provider database used for storing instance and credential information",
          "minLength": 1
        },
        "pam_types": {
          "description": "Key-value pair of PAM types supported by the integration",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PamType"
          }
        }
      }
    },
    "AboutAnyCAREST": {
      "type": "object",
      "required": ["ca_plugin_config", "enrollment_config"],
      "properties": {
        "product_ids": {
          "description": "A list of product IDs corresponding to certificate services offered by the CA",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ca_plugin_config": {
          "description": "A list of plugin configuration fields used to configure defined CAs in the Keyfactor AnyCA Gateway REST",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NameDescriptionObject"
          }
        },
        "enrollment_config": {
          "description": "A list of custom enrollment parameters that are used by defined CAs in the Keyfactor AnyCA Gateway REST for certificate enrollment",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NameDescriptionObject"
          }
        }
      }
    },
    "StoreType": {
      "description": "Certificate Store Type definition intermediate object representation",
      "type": "object",
      "required": [
        "Name",
        "Capability",
        "SupportedOperations",
        "Properties",
        "PasswordOptions",
        "PrivateKeyAllowed",
        "ServerRequired",
        "PowerShell",
        "BlueprintAllowed",
        "StorePathDescription",
        "ClientMachineDescription"
      ],
      "properties": {
        "Name": {
          "type": "string"
        },
        "ShortName": {
          "type": "string"
        },
        "Capability": {
          "type": "string"
        },
        "LocalStore": {
          "type": "boolean"
        },
        "ClientMachineDescription": {
          "type": "string"
        },
        "StorePathDescription": {
          "type": "string"
        },
        "SupportedOperations": {
          "type": "object",
          "required": ["Add", "Remove", "Enrollment", "Discovery"],
          "properties": {
            "Add": {
              "type": "boolean"
            },
            "Remove": {
              "type": "boolean"
            },
            "Enrollment": {
              "type": "boolean"
            },
            "Discovery": {
              "type": "boolean"
            }
          }
        },
        "Properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["Name", "DisplayName", "Type", "Description"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "IsPAMEligible": {
                "description": "Indicates that the store type property can be fetched from a configured orchestrator-side PAM provider",
                "type": "boolean"
              },
              "DisplayName": {
                "type": "string"
              },
              "Type": {
                "type": "string"
              },
              "DependsOn": {
                "type": "string"
              },
              "DefaultValue": {
                "type": "string"
              },
              "Required": {
                "type": "boolean"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        },
        "EntryParameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["Name", "DisplayName", "Type", "Description"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "DisplayName": {
                "type": "string"
              },
              "Type": {
                "type": "string"
              },
              "RequiredWhen": {
                "type": "object",
                "properties": {
                  "HasPrivateKey": {
                    "type": "boolean"
                  },
                  "OnAdd": {
                    "type": "boolean"
                  },
                  "OnRemove": {
                    "type": "boolean"
                  },
                  "OnReenrollment": {
                    "type": "boolean"
                  }
                }
              },
              "DefaultValue": {
                "type": "string"
              },
              "DependsOn": {
                "type": "string"
              },
              "Options": {
                "type": "string"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        },
        "PasswordOptions": {
          "type": "object",
          "required": ["EntrySupported", "StoreRequired", "Style"],
          "properties": {
            "EntrySupported": {
              "type": "boolean"
            },
            "StoreRequired": {
              "type": "boolean"
            },
            "Style": {
              "enum": ["Default", "Custom"]
            }
          }
        },
        "StorePathType": {
          "type": "string"
        },
        "StorePathValue": {
          "type": "string"
        },
        "PrivateKeyAllowed": {
          "enum": ["Required", "Optional", "Forbidden"]
        },
        "JobProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ServerRequired": {
          "type": "boolean"
        },
        "PowerShell": {
          "type": "boolean"
        },
        "BlueprintAllowed": {
          "type": "boolean"
        },
        "CustomAliasAllowed": {
          "enum": ["Required", "Optional", "Forbidden"]
        }
      }
    },
    "PamType": {
      "description": "PAM Type definition intermediate object representation",
      "type": "object",
      "required": ["Name", "Parameters"],
      "properties": {
        "Name": {
          "type": "string"
        },
        "Parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Name",
              "DisplayName",
              "DataType",
              "InstanceLevel",
              "Description"
            ],
            "properties": {
              "Name": {
                "type": "string"
              },
              "DisplayName": {
                "type": "string"
              },
              "DataType": {
                "type": "integer"
              },
              "InstanceLevel": {
                "type": "boolean"
              },
              "Description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "NameDescriptionObject": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "description": "The name of the specific configuration field",
          "type": "string"
        },
        "description": {
          "description": "A description of the specific configuration field",
          "type": "string"
        }
      }
    }
  }
}
