{
  "name": "PAM Provider Integration",
  "description": "Privileged Access Management provider with complete configuration",
  "integration_type": "pam",
  "support_level": "kf-community",
  "status": "pilot",
  "link_github": true,
  "update_catalog": true,
  "pamRegDLL": "MyPamProvider/bin/Registration.dll",
  "about": {
    "pam": {
      "assemblyName": "MyPamProvider",
      "providerName": "mypam",
      "fullyQualifiedClassName": "MyCompany.PAM.MyPamProvider",
      "dbName": "MyPamDatabase",
      "pam_types": {
        "password": {
          "Name": "Password",
          "Description": "Standard password rotation",
          "Parameters": [
            {
              "Name": "RotationInterval",
              "DisplayName": "Rotation Interval",
              "DataType": 1,
              "InstanceLevel": false,
              "Description": "Number of days between password rotations"
            }
          ]
        },
        "ssh_key": {
          "Name": "SSH Key",
          "Description": "SSH key management",
          "Parameters": [
            {
              "Name": "KeyLength",
              "DisplayName": "SSH Key Length",
              "DataType": 2,
              "InstanceLevel": false,
              "Description": "Length of generated SSH keys in bits"
            }
          ]
        }
      }
    }
  }
}
