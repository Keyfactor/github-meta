              "Required": true,
              "Description": "A test property for the store type"
            }
          ],
          "EntryParameters": [
            {
              "Name": "TestParam",
              "DisplayName": "Test Parameter",
              "Type": "String",
              "RequiredWhen": {
                "HasPrivateKey": true,
                "OnAdd": true,
                "OnRemove": false,
                "OnReenrollment": false
              },
              "DefaultValue": "",
